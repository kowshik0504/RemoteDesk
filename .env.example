# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SETUP_PASSCODE: Optional shared passcode for registering additional admin accounts.
# If unset on first run, the first administrator can claim credentials via the setup form.
ADMIN_SETUP_PASSCODE=

# Cloud SQL (PostgreSQL) connection parameters (auto-injected in Cloud Run / AI Studio)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
